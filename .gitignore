# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Real / patient DICOM must never be committed (see AGENTS.md, tests/README.md)
dicom/

# Generated workflow-matrix report (rebuild with matrix/generate_report.py)
matrix_report.html

# Anything the phantom generator or the pre-release sweep produces. Both write
# outside the repo by default (~/test_swane), but --work-dir / $SWANE_PHANTOM_DIR
# can point here: those outputs are derived from the user's FreeSurfer install
# and must never be committed.
test_swane/
prerelease_report.*
prerelease_state.json

.spyproject
SWANe.egg-info
swane.egg-info
dist
release
build
venv
.venv/
.venv-test/
/.vscode
/swane/.vscode
/swane_supplement
/myenv

.superpowers/
